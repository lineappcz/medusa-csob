{
  "name": "@lineapp/medusa-csob",
  "version": "0.1.0",
  "description": "CSOB eAPI payment provider and signed gateway client for Medusa v2",
  "license": "MIT",
  "author": "LINEAPP",
  "packageManager": "pnpm@10.11.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lineappcz/medusa-csob.git"
  },
  "homepage": "https://github.com/lineappcz/medusa-csob#readme",
  "bugs": {
    "url": "https://github.com/lineappcz/medusa-csob/issues"
  },
  "keywords": [
    "medusa-v2",
    "medusa-plugin-integration",
    "medusa-plugin-payment",
    "csob"
  ],
  "main": "./dist/provider/index.js",
  "types": "./dist/provider/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/provider/index.d.ts",
      "default": "./dist/provider/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./client/*": {
      "types": "./dist/client/*.d.ts",
      "default": "./dist/client/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs",
    "examples",
    "AGENTS.md",
    "llms.txt"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm test:coverage && pnpm build",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "@medusajs/framework": ">=2.19.0 <3"
  },
  "dependencies": {
    "ioredis": "5.11.1"
  },
  "devDependencies": {
    "@medusajs/framework": "2.19.0",
    "@medusajs/eslint-plugin": "2.19.0",
    "@swc/core": "1.15.18",
    "@swc/jest": "0.2.39",
    "@types/jest": "29.5.14",
    "@types/node": "22.19.11",
    "eslint": "9.39.4",
    "jest": "29.7.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  }
}
